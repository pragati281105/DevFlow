# Copy to .env and fill in real values. Never commit .env.
# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow

# Test database (used by integration tests — must be a separate DB)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow_test

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Session ─────────────────────────────────────────────────────────────────
# 32+ random bytes encoded as hex. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ── GitHub integration (Milestone 4) ────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
